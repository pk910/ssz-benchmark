# secrets: the daemon's environment file, App and TLS keys, tokens
env
*.env
.env*
*.pem
*.key
*.p12
*token*

# data the daemon produces: database, job logs, checkouts, builds
*.db
*.db-wal
*.db-shm
/jobs/
/wt/
/hb/
/work/
repo.git/

# payload files are generated (harness/cmd/payload) and live on the box
/payload-out/
/harness/payload
*.ssz

# generated per checkout by the daemon
/harness/types/*/gen_ssz.go
/harness/dynssz-gen

# what the builds of the adapters of other languages leave behind
/harness/baselines/*/work/
/harness/baselines/*/target/
/harness/baselines/*/node_modules/
/harness/baselines/*/build/
/harness/baselines/*/.gradle/
/harness/baselines/*/out/
/harness/baselines/*/nimcache/
/harness/baselines/*/Cargo.lock

# build and test artefacts
*.test
*.out
*.prof
/benchd/benchd
/benchd/benchweb
*.patch
*.orig
*.rej
.DS_Store

# planning notes stay local
/ai_plans/

# python caches of the type converters
__pycache__/
